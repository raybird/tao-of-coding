{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tao-of-coding/schemas/agent-message-1.0.json",
  "title": "Tao Agent Message",
  "description": "Structured envelope every agent invocation must return. Enables fan-out, reducers, and run-state reconstruction without parsing free-form markdown.",
  "type": "object",
  "required": ["schema_version", "task_id", "role", "skill", "status", "outputs"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": "1.0" },
    "task_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{2,63}$",
      "description": "Unique within a run. Convention: <role>-<step>-<short-slug>."
    },
    "parent_task_id": { "type": ["string", "null"] },
    "request_id": { "type": "string" },
    "role": { "enum": ["explorer", "oracle", "librarian", "fixer", "designer"] },
    "skill": { "type": "string" },
    "status": {
      "enum": ["ok", "partial", "blocked", "malformed", "failed"],
      "description": "ok=done; partial=usable but incomplete; blocked=needs external input; malformed=output failed validation; failed=runtime error."
    },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "inputs": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "prompt": { "type": "string" },
        "artifacts": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Paths (relative to run workspace) of artifacts consumed."
        }
      }
    },
    "outputs": {
      "type": "object",
      "required": ["summary"],
      "additionalProperties": false,
      "properties": {
        "summary": {
          "type": "string",
          "maxLength": 2000,
          "description": "One-paragraph human summary. Long-form content goes in artifacts."
        },
        "artifacts": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["path", "kind"],
            "additionalProperties": false,
            "properties": {
              "path": { "type": "string" },
              "kind": { "enum": ["report", "plan", "code", "test", "doc", "documentation", "spec", "diff", "log", "other"] },
              "description": { "type": "string" }
            }
          }
        },
        "findings": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "severity", "message"],
            "additionalProperties": false,
            "properties": {
              "id": { "type": "string" },
              "severity": { "enum": ["info", "low", "medium", "high", "critical"] },
              "message": { "type": "string" },
              "location": { "type": "string", "description": "file:line or path." }
            }
          }
        },
        "next_actions": {
          "type": "array",
          "description": "Suggested follow-up agent calls. The orchestrator decides whether to fan-out.",
          "items": {
            "type": "object",
            "required": ["role", "skill", "prompt"],
            "additionalProperties": false,
            "properties": {
              "role": { "enum": ["explorer", "oracle", "librarian", "fixer", "designer"] },
              "skill": { "type": "string" },
              "prompt": { "type": "string" },
              "depends_on": {
                "type": "array",
                "items": { "type": "string" },
                "description": "task_id list. Empty/omitted = can run in parallel with siblings."
              },
              "parallelizable": { "type": "boolean" }
            }
          }
        }
      }
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "model": { "type": "string" },
        "started_at": { "type": "string", "format": "date-time" },
        "finished_at": { "type": "string", "format": "date-time" },
        "tokens_estimate": { "type": "integer", "minimum": 0 }
      }
    },
    "errors": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["code", "message"],
        "additionalProperties": false,
        "properties": {
          "code": { "type": "string" },
          "message": { "type": "string" }
        }
      }
    }
  }
}
